                'ig-single': 60, 'ig-group': 420, 'ig-indiv': 480,
                'u-single': 70, 'u-group': 450, 'u-indiv': 520
            }
        },
        'KW': {
            name: 'الكويت',
            unit: 'د.ك / للباقة',
            unitGroup: 'د.ك / للطالب',
            unitSingle: 'د.ك / للحصة',
            rates: {
                'p-single': 3.5, 'p-group': 23, 'p-indiv': 26,
                'm-single': 4, 'm-group': 24, 'm-indiv': 28,
                'h-single': 4.5, 'h-group': 28, 'h-indiv': 32,
                'ig-single': 5, 'ig-group': 34, 'ig-indiv': 39,
                'u-single': 6, 'u-group': 36, 'u-indiv': 42
            }
        },
        'OM': {
            name: 'عُمان',
            unit: 'ر.ع / للباقة',
            unitGroup: 'ر.ع / للطالب',
            unitSingle: 'ر.ع / للحصة',
            rates: {
                'p-single': 4, 'p-group': 29, 'p-indiv': 32,
                'm-single': 4.5, 'm-group': 30, 'm-indiv': 35,
                'h-single': 5, 'h-group': 35, 'h-indiv': 40,
                'ig-single': 6, 'ig-group': 42, 'ig-indiv': 48,
                'u-single': 7, 'u-group': 45, 'u-indiv': 52
            }
        },
        'AE': {
            name: 'الإمارات',
            unit: 'د.إ / للباقة',
            unitGroup: 'د.إ / للطالب',
            unitSingle: 'د.إ / للحصة',
            rates: {
                'p-single': 40, 'p-group': 290, 'p-indiv': 320,
                'm-single': 45, 'm-group': 300, 'm-indiv': 350,
                'h-single': 50, 'h-group': 350, 'h-indiv': 400,
                'ig-single': 60, 'ig-group': 420, 'ig-indiv': 480,
                'u-single': 70, 'u-group': 450, 'u-indiv': 520
            }
        },
        'QA': {
            name: 'قطر',
            unit: 'ر.ق / للباقة',
            unitGroup: 'ر.ق / للطالب',
            unitSingle: 'ر.ق / للحصة',
            rates: {
                'p-single': 40, 'p-group': 290, 'p-indiv': 320,
                'm-single': 45, 'm-group': 300, 'm-indiv': 350,
                'h-single': 50, 'h-group': 350, 'h-indiv': 400,
                'ig-single': 60, 'ig-group': 420, 'ig-indiv': 480,
                'u-single': 70, 'u-group': 450, 'u-indiv': 520
            }
        }
    };

    let currentCountry = 'SA';

    // دالة تغيير الدولة والعملة
    function selectCountry(code) {
        currentCountry = code;
        const data = countryData[code];

        // تحديث حالة أزرار العملات
        document.querySelectorAll('.currency-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-country') === code);
        });

        // تحديث المبالغ في الكروت
        document.querySelectorAll('.amount[data-pricing]').forEach(el => {
            const key = el.getAttribute('data-pricing');
            if (data.rates[key]) {
                el.innerText = data.rates[key];
            }
        });

        // تحديث نصوص العملة (للباقة، المجموعة، أو الحصة)
        document.querySelectorAll('.currency-unit').forEach(el => {
            const key = el.previousElementSibling ? el.previousElementSibling.getAttribute('data-pricing') : '';
            if (key.includes('single')) {
                el.innerText = data.unitSingle;
            } else if (key.includes('group')) {
                el.innerText = data.unitGroup;
            } else {
                el.innerText = data.unit;
            }
        });

        // تحديث روابط الواتساب
        updateBookingLinks();
    }

    // تحديث روابط الواتساب ديناميكياً مع بيانات الباقة والعملة
    function updateBookingLinks() {
        const data = countryData[currentCountry];
        document.querySelectorAll('.btn-booking').forEach(btn => {
            const pkgName = btn.getAttribute('data-pkg');
            const priceEl = btn.parentElement.querySelector('.amount');
            const price = priceEl ? priceEl.innerText : '';
            const currency = data.unitSingle.split('/')[0].trim();
            
            const text = `مرحباً منصة نجود، أريد الاشتراك في (${pkgName}) - بسعر ${price} ${currency} (دولة ${data.name})`;
            btn.href = `https://wa.me/201039353583?text=${encodeURIComponent(text)}`;
            btn.target = "_blank";
        });
    }

    // دالة التبديل بين التبويبات (Tabs)
    function openTab(evt, tabName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].classList.remove("active");
        }
        tablinks = document.getElementsByClassName("tab-btn");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    // دالة الأسئلة الشائعة
    function toggleFaq(element) {
        element.classList.toggle('active');
    }

    // زر العودة للأعلى
    window.onscroll = function() {
        const backToTopBtn = document.getElementById('backToTop');
        if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
            backToTopBtn.classList.add('show');
        } else {
            backToTopBtn.classList.remove('show');
        }
        revealOnScroll();
    };

    function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // انيميشن الظهور عند السكرول
    function revealOnScroll() {
        var reveals = document.querySelectorAll(".reveal");
        for (var i = 0; i < reveals.length; i++) {
            var windowHeight = window.innerHeight;
            var elementTop = reveals[i].getBoundingClientRect().top;
            var elementVisible = 100;
            if (elementTop < windowHeight - elementVisible) {
                reveals[i].classList.add("active");
            }
        }
    }

    // العداد التصاعدي
    let countStarted = false;
    window.addEventListener('scroll', () => {
        const statsSection = document.querySelector('.stats-section');
        if (statsSection && !countStarted) {
            const pos = statsSection.getBoundingClientRect().top;
            if (pos < window.innerHeight) {
                document.querySelectorAll('.counter').forEach(counter => {
                    const target = +counter.getAttribute('data-target');
                    let count = 0;
                    const inc = target / 50;
                    const updateCount = () => {
                        count += inc;
                        if (count < target) {
                            counter.innerText = Math.ceil(count);
                            setTimeout(updateCount, 30);
                        } else {
                            counter.innerText = target + (target === 100 ? '%' : '+');
                        }
                    };
                    updateCount();
                });
                countStarted = true;
            }
        }
    });

    // تشغيل البداية عند تحميل الصفحة
    document.addEventListener('DOMContentLoaded', () => {
        selectCountry('SA');
        revealOnScroll();
    });
</script>
